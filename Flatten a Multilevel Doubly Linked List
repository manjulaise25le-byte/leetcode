class Node:
    def __init__(self, val, prev, next, child):
        self.val = val
        self.prev = prev
        self.next = next
        self.child = child

class Solution:
    def flatten(self, head):
        if head is None:
            return None

        current = head

        while current:
            if current.child:
                child = current.child
                next_node = current.next

                # Connect current to its child
                current.next = child
                child.prev = current
                current.child = None

                # Find the last node of the child list
                last = child
                while last.next:
                    last = last.next

                # Connect the child list to the original next node
                if next_node:
                    last.next = next_node
                    next_node.prev = last

            current = current.next

        return head
